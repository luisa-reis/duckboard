{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "panel-ddp configuration",
  "type": "object",
  "properties": {
    "target": {
      "description": "WLED host, \"host\" or \"host:port\".",
      "type": "string"
    },
    "width": {
      "description": "The panel's width in pixels; WLED must be set up as a matrix of the\nsame size.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 64
    },
    "height": {
      "description": "The panel's height in pixels.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 64
    },
    "fps": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 10
    },
    "gamma": {
      "description": "Gamma applied to pictures before they are sent: WLED does not\ncorrect streamed frames, so sRGB pictures need 2.2.",
      "type": "number",
      "format": "float",
      "default": 2.200000047683716
    },
    "temperature": {
      "description": "The unit every temperature is shown in.",
      "default": "fahrenheit",
      "allOf": [
        {
          "$ref": "#/definitions/Units"
        }
      ]
    },
    "gaps": {
      "description": "A copy of the board's gap file, for previews; relative to this file.",
      "type": "string",
      "default": "2d-gaps.json"
    },
    "secrets": {
      "description": "The secrets file, names to values, relative to this file.",
      "type": "string",
      "default": "secrets.yaml"
    },
    "sources": {
      "$ref": "#/definitions/Sources"
    },
    "art_cache": {
      "default": {
        "dir": "art-cache",
        "max_megabytes": 4.0,
        "keep_originals": false
      },
      "allOf": [
        {
          "$ref": "#/definitions/ArtCacheConfig"
        }
      ]
    },
    "art_file": {
      "description": "A JPEG kept at the album cover on show; relative to this file.",
      "type": [
        "string",
        "null"
      ]
    },
    "art_open": {
      "description": "Run `open` on the art file after each change (macOS Preview).",
      "type": "boolean",
      "default": false
    },
    "schemes": {
      "description": "Colour schemes by name; `default` applies to every tile.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Overrides"
      },
      "default": {}
    },
    "layouts": {
      "description": "Layouts by name: regions of the panel by name.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/Region"
        }
      }
    },
    "tiles": {
      "description": "Tiles by name, for pages to place.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Tile"
      }
    },
    "page_seconds": {
      "description": "How long a page shows when it does not say, in seconds.",
      "type": "number",
      "format": "float",
      "default": 10.0
    },
    "pages": {
      "description": "Pages by name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Page"
      }
    },
    "playlists": {
      "description": "Playlists by name: pages shown in turn, looping.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "schedule": {
      "description": "The first rule that matches picks the playlist; none matching sends\nnothing, so the board falls back to its presets.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Rule"
      }
    },
    "alerts": {
      "description": "While an entity is in its state, the panel pulses with its label.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/Alert"
      },
      "default": []
    },
    "alert_area": {
      "description": "Where an alert centres its label; a 22x22 square in the middle of\nthe panel when left out.",
      "anyOf": [
        {
          "$ref": "#/definitions/Area"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "target",
    "pages"
  ],
  "definitions": {
    "Units": {
      "type": "string",
      "enum": [
        "celsius",
        "fahrenheit"
      ]
    },
    "Sources": {
      "type": "object",
      "properties": {
        "weather": {
          "anyOf": [
            {
              "$ref": "#/definitions/WeatherConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "home_assistant": {
          "anyOf": [
            {
              "$ref": "#/definitions/HomeAssistant"
            },
            {
              "type": "null"
            }
          ]
        },
        "spotify": {
          "description": "Takes precedence over a Home Assistant media player.",
          "anyOf": [
            {
              "$ref": "#/definitions/SpotifyConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "pictures": {
          "description": "A folder of pictures for picture tiles.",
          "anyOf": [
            {
              "$ref": "#/definitions/Pictures"
            },
            {
              "type": "null"
            }
          ]
        },
        "http": {
          "description": "An HTTP endpoint taking the values of chart series.",
          "anyOf": [
            {
              "$ref": "#/definitions/Http"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "WeatherConfig": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "format": "double"
        },
        "longitude": {
          "type": "number",
          "format": "double"
        },
        "units": {
          "description": "Overrides the top-level `temperature` for the weather tile alone.\nLeft out, the loader fills it in.",
          "anyOf": [
            {
              "$ref": "#/definitions/Units"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh_minutes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        }
      },
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ]
    },
    "HomeAssistant": {
      "type": "object",
      "properties": {
        "url": {
          "description": "e.g. \"http://homeassistant.local:8123\"",
          "type": "string"
        },
        "token": {
          "description": "A long-lived access token (profile page, Security tab), kept in the\nsecrets file.",
          "allOf": [
            {
              "$ref": "#/definitions/SecretRef"
            }
          ]
        },
        "media_player": {
          "description": "The media_player entity for now_playing and art tiles, when there\nis no Spotify.",
          "type": [
            "string",
            "null"
          ]
        },
        "refresh_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        }
      },
      "additionalProperties": false,
      "required": [
        "url",
        "token"
      ]
    },
    "SecretRef": {
      "description": "A reference to a secret by name.",
      "type": "object",
      "properties": {
        "secret": {
          "description": "The secret's name in the secrets file; the environment variable\nPANEL_DDP_SECRET_<NAME> overrides it.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "secret"
      ]
    },
    "SpotifyConfig": {
      "type": "object",
      "properties": {
        "client_id": {
          "description": "The Client ID of an app from developer.spotify.com/dashboard.",
          "type": "string"
        },
        "token_file": {
          "description": "Where `panel-ddp spotify-login` keeps the tokens, relative to the\nconfig file.",
          "type": "string",
          "default": "spotify-token.json"
        },
        "refresh_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5
        }
      },
      "additionalProperties": false,
      "required": [
        "client_id"
      ]
    },
    "Pictures": {
      "type": "object",
      "properties": {
        "dir": {
          "description": "Relative to this file.",
          "type": "string",
          "default": "frame"
        },
        "seconds": {
          "description": "Each picture, in seconds.",
          "type": "number",
          "format": "float",
          "default": 10.0
        },
        "shuffle": {
          "description": "Random order, reshuffled at each start; else by file name.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Http": {
      "type": "object",
      "properties": {
        "listen": {
          "description": "The address and port to listen on. The default takes requests from\nthis machine only; \"0.0.0.0:4049\" takes them from the network.",
          "type": "string",
          "default": "127.0.0.1:4049"
        },
        "token": {
          "description": "A token every request must then carry, as the header\n`Authorization: Bearer TOKEN`, kept in the secrets file. Without\none, anything that reaches the port can change the series.",
          "anyOf": [
            {
              "$ref": "#/definitions/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ArtCacheConfig": {
      "description": "Where decoded album art is kept between runs, and how much of it.",
      "type": "object",
      "properties": {
        "dir": {
          "description": "Relative to the config file.",
          "type": "string",
          "default": "art-cache"
        },
        "max_megabytes": {
          "description": "0 disables the cache.",
          "type": "number",
          "format": "double",
          "default": 4.0
        },
        "keep_originals": {
          "description": "Also keep each picture as downloaded, at its original size, and ask\nSpotify for its largest. The `art_file` is then written from\nit. Costs a few tens of kilobytes per cover against the cap.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Overrides": {
      "description": "The same roles, each optional: what a config table sets.",
      "type": "object",
      "properties": {
        "text": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "track": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "accent": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "full": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "sun": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "moon": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "cloud": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "storm_cloud": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "rain": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "snow": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        },
        "fog": {
          "anyOf": [
            {
              "$ref": "#/definitions/Colour"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Colour": {
      "description": "A colour, \"#rrggbb\", or \"#rrggbbaa\" with alpha to blend it over what is under it.",
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "Region": {
      "description": "A region of a layout: a rectangle, and where it stacks. Regions are drawn\nin ascending `z`, those with the same `z` in the layout's order.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "z": {
          "type": "integer",
          "format": "int32",
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "Tile": {
      "oneOf": [
        {
          "description": "Hours over minutes inside a seconds ring.",
          "type": "object",
          "properties": {
            "seconds": {
              "default": "dot",
              "allOf": [
                {
                  "$ref": "#/definitions/Seconds"
                }
              ]
            },
            "dot_size": {
              "description": "Ring pixels the seconds dot covers.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 2
            },
            "kind": {
              "type": "string",
              "const": "clock"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Weekday, day of month, month.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "date"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "One line of text.",
          "type": "object",
          "properties": {
            "text": {
              "description": "The line itself.",
              "type": [
                "string",
                "null"
              ]
            },
            "column": {
              "description": "On a table's repeat row: the column of the pushed rows the line\ncomes from, in place of `text`.",
              "type": [
                "string",
                "null"
              ]
            },
            "size": {
              "default": "6x10",
              "allOf": [
                {
                  "$ref": "#/definitions/TextSize"
                }
              ]
            },
            "align": {
              "description": "Which side of the region the line is set against.",
              "default": "center",
              "allOf": [
                {
                  "$ref": "#/definitions/Align"
                }
              ]
            },
            "overflow": {
              "description": "What happens to a line wider than the region.",
              "default": "scroll",
              "allOf": [
                {
                  "$ref": "#/definitions/Overflow"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "text"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Sky icon and temperature; needs sources.weather.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "weather"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "A Home Assistant entity's state under a label; needs sources.home_assistant.",
          "type": "object",
          "properties": {
            "entity": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "unit": {
              "description": "Overrides the entity's unit_of_measurement; \"\" hides it.",
              "type": [
                "string",
                "null"
              ]
            },
            "decimals": {
              "description": "Decimal places for a numeric state; fewer are used if it does not fit.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            },
            "kind": {
              "type": "string",
              "const": "sensor"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entity",
            "label"
          ]
        },
        {
          "description": "A Home Assistant entity's numeric state as a bar under the value,\nfull at `max`; needs sources.home_assistant.",
          "type": "object",
          "properties": {
            "entity": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "max": {
              "type": "number",
              "format": "double",
              "default": 100.0
            },
            "decimals": {
              "description": "Decimal places for the value; 0 unless set.",
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255,
              "default": 0
            },
            "kind": {
              "type": "string",
              "const": "progress"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "entity",
            "label"
          ]
        },
        {
          "description": "A line, low at the bottom of the region and high at the top, of\neither a Home Assistant `entity`'s numeric history (needs\nsources.home_assistant) or a `series` pushed over HTTP (needs\nsources.http).",
          "type": "object",
          "properties": {
            "entity": {
              "type": [
                "string",
                "null"
              ]
            },
            "series": {
              "description": "The name the values are pushed under, at /series/NAME: letters,\ndigits, `.`, `_` and `-`.",
              "type": [
                "string",
                "null"
              ]
            },
            "column": {
              "description": "On a table's repeat row: the column of the pushed rows the\nvalues come from, an array of numbers, in place of `entity` and\n`series`.",
              "type": [
                "string",
                "null"
              ]
            },
            "hours": {
              "description": "How far back an entity's line goes.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 24
            },
            "line": {
              "description": "The line's colour; the `accent` colour unless set.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Colour"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dot": {
              "description": "A dot at the latest value, in this colour; none unless set.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Colour"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "line_chart"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "A line chart with the area under the line filled, to the bottom of\nthe region; the same sources as a line chart.",
          "type": "object",
          "properties": {
            "entity": {
              "type": [
                "string",
                "null"
              ]
            },
            "series": {
              "description": "The name the values are pushed under, at /series/NAME: letters,\ndigits, `.`, `_` and `-`.",
              "type": [
                "string",
                "null"
              ]
            },
            "column": {
              "description": "On a table's repeat row: the column of the pushed rows the\nvalues come from, an array of numbers, in place of `entity` and\n`series`.",
              "type": [
                "string",
                "null"
              ]
            },
            "hours": {
              "description": "How far back an entity's line goes.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 24
            },
            "line": {
              "description": "The line's colour; the `accent` colour unless set.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Colour"
                },
                {
                  "type": "null"
                }
              ]
            },
            "area": {
              "description": "The area's colour; the line's at a third of its strength unless\nset.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Colour"
                },
                {
                  "type": "null"
                }
              ]
            },
            "area_bottom": {
              "description": "Makes the area a gradient: `area` on the region's top row, this\ncolour on its bottom row. An alpha of 00 fades it out.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Colour"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dot": {
              "description": "A dot at the latest value, in this colour; none unless set.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Colour"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "area_chart"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "The values as bars rising from the bottom of the region, which\nstands for zero (or for the lowest value, when there are negative\nones); the same sources as a line chart.",
          "type": "object",
          "properties": {
            "entity": {
              "type": [
                "string",
                "null"
              ]
            },
            "series": {
              "description": "The name the values are pushed under, at /series/NAME: letters,\ndigits, `.`, `_` and `-`.",
              "type": [
                "string",
                "null"
              ]
            },
            "column": {
              "description": "On a table's repeat row: the column of the pushed rows the\nvalues come from, an array of numbers, in place of `entity` and\n`series`.",
              "type": [
