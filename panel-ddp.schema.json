                  "$ref": "#/definitions/Colour"
                },
                {
                  "type": "null"
                }
              ]
            },
            "width": {
              "description": "A bar's width in pixels.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 2
            },
            "gap": {
              "description": "The pixels between two bars.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 1
            },
            "kind": {
              "type": "string",
              "const": "bar_chart"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Artist and title scrolling; needs sources.spotify or a Home Assistant media_player.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "now_playing"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "The album art; needs sources.spotify or a Home Assistant media_player.",
          "type": "object",
          "properties": {
            "shape": {
              "default": "disc",
              "allOf": [
                {
                  "$ref": "#/definitions/ArtShape"
                }
              ]
            },
            "spin": {
              "description": "Turn the art while playing.",
              "type": "boolean",
              "default": false
            },
            "paused_alpha": {
              "description": "The art's alpha while paused.",
              "type": "number",
              "format": "float",
              "default": 0.4000000059604645
            },
            "corner_alpha": {
              "description": "The alpha of the corners outside the circle in the faded shape.",
              "type": "number",
              "format": "float",
              "default": 0.30000001192092896
            },
            "alpha": {
              "description": "The art's alpha over what is drawn under it.",
              "type": "number",
              "format": "float",
              "default": 1.0
            },
            "idle": {
              "description": "What shows while there is no art.",
              "default": "ripple",
              "allOf": [
                {
                  "$ref": "#/definitions/Idle"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "art"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "The picture from `sources.pictures` due now, at `alpha` over what is\ndrawn under it.",
          "type": "object",
          "properties": {
            "alpha": {
              "type": "number",
              "format": "float",
              "default": 1.0
            },
            "kind": {
              "type": "string",
              "const": "picture"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Nothing.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "blank"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "description": "Rows of tiles, stacked from the top of the region.",
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Row"
              }
            },
            "data": {
              "description": "The name rows are pushed under, at /tables/NAME, for the table's\nrepeat row: letters, digits, `.`, `_` and `-`.",
              "type": [
                "string",
                "null"
              ]
            },
            "gap": {
              "description": "Pixels between two rows.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "default": 0
            },
            "kind": {
              "type": "string",
              "const": "table"
            },
            "scheme": {
              "description": "A colour scheme's name, over the page's.",
              "type": "string"
            },
            "colors": {
              "$ref": "#/definitions/Overrides"
            }
          },
          "additionalProperties": false,
          "required": [
            "rows",
            "kind"
          ]
        }
      ]
    },
    "Seconds": {
      "description": "How the clock shows the seconds on its ring.",
      "oneOf": [
        {
          "description": "The ring fills clockwise from twelve.",
          "type": "string",
          "const": "ring"
        },
        {
          "description": "A single dot travels round the ring, like a second hand.",
          "type": "string",
          "const": "dot"
        }
      ]
    },
    "TextSize": {
      "description": "A text tile's font, by the width and height of a character in pixels.",
      "type": "string",
      "enum": [
        "4x6",
        "5x7",
        "5x8",
        "6x9",
        "6x10",
        "6x12",
        "6x13",
        "7x13",
        "7x14",
        "8x13",
        "9x15",
        "9x18",
        "10x20"
      ]
    },
    "Align": {
      "description": "Where a text tile's line sits across its region.",
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "Overflow": {
      "description": "What a text tile does with a line wider than its region.",
      "oneOf": [
        {
          "description": "It scrolls, whatever the alignment.",
          "type": "string",
          "const": "scroll"
        },
        {
          "description": "It is cut to the whole characters that fit, and aligned.",
          "type": "string",
          "const": "truncate"
        }
      ]
    },
    "ArtShape": {
      "oneOf": [
        {
          "description": "A record: circular, with a spindle hole.",
          "type": "string",
          "const": "disc"
        },
        {
          "description": "The whole cover.",
          "type": "string",
          "const": "square"
        },
        {
          "description": "The whole cover, the corners outside the circle dimmed.",
          "type": "string",
          "const": "faded"
        }
      ]
    },
    "Idle": {
      "description": "What an art tile shows while there is no art.",
      "oneOf": [
        {
          "description": "A slow ripple from the middle.",
          "type": "string",
          "const": "ripple"
        },
        {
          "description": "Nothing.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "Row": {
      "description": "A row of a table: its height, and the tiles on it.",
      "type": "object",
      "properties": {
        "height": {
          "description": "In pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "repeat": {
          "description": "Lays the row out once for each row pushed as the table's `data`, as\nmany as fit the region; its tiles take their values by `column`.\nOnly the last row repeats.",
          "type": "boolean",
          "default": false
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Cell"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "height"
      ]
    },
    "Cell": {
      "description": "A tile on a row, placed from the row's top left corner.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Pixels from the row's left edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "description": "Pixels from the row's top edge.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "description": "The rest of the row's height unless set.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tile": {
          "description": "A tile's name from `tiles`, or a tile spelt out; not a table.",
          "allOf": [
            {
              "$ref": "#/definitions/TileRef"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "width",
        "tile"
      ]
    },
    "TileRef": {
      "description": "A tile's name from `tiles`, or a tile spelt out.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/Tile"
        }
      ]
    },
    "Page": {
      "type": "object",
      "properties": {
        "layout": {
          "description": "The layout's name.",
          "type": "string"
        },
        "seconds": {
          "description": "How long the page shows; `page_seconds` when left out.",
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "scheme": {
          "description": "A scheme over the default one for every tile on the page.",
          "type": [
            "string",
            "null"
          ]
        },
        "tiles": {
          "description": "The tile in each region, by region name. Regions left out stay\nempty.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/TileRef"
          }
        },
        "data": {
          "description": "Values laid over the live data while the page shows.",
          "default": {
            "weather": null,
            "sensors": {},
            "series": {},
            "tables": {},
            "cover": null,
            "picture": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/PageData"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "layout"
      ]
    },
    "PageData": {
      "description": "Values a page lays over the live data, for demos and for pinning a page\nto something the sources do not report.",
      "type": "object",
      "properties": {
        "weather": {
          "anyOf": [
            {
              "$ref": "#/definitions/WeatherData"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensors": {
          "description": "By entity id: a fixed state, or a sweep from one number to another\nover the page's time.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/SensorData"
          },
          "default": {}
        },
        "series": {
          "description": "By entity id or series name: the values a chart of it draws,\noldest first, whatever its `hours`.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          },
          "default": {}
        },
        "tables": {
          "description": "By table data name: the rows a table's repeat row draws, each a map\nof column to value, as they are pushed to /tables/NAME.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "default": {}
        },
        "cover": {
          "description": "A cover from the art cache, newest first (0 is the newest), played.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "picture": {
          "description": "The picture from `sources.pictures`, by position, for picture tiles.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "WeatherData": {
      "type": "object",
      "properties": {
        "code": {
          "description": "WMO weather code.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "is_day": {
          "type": "boolean",
          "default": true
        },
        "temperature": {
          "description": "In the configured `temperature` unit.",
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "temperature"
      ]
    },
    "SensorData": {
      "type": "object",
      "properties": {
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "sweep": {
          "description": "From, to: the value moves linearly across the page, rounded.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Rule": {
      "type": "object",
      "properties": {
        "playlist": {
          "type": "string"
        },
        "when": {
          "description": "Left out, the rule always matches.",
          "anyOf": [
            {
              "$ref": "#/definitions/When"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "playlist"
      ]
    },
    "When": {
      "description": "When a schedule rule applies: on some days, between two times of day.\nLeft out, a part does not limit: no `days` is every day, no `from` is\nfrom midnight, no `to` is until midnight. A `to` earlier than `from`\nruns past midnight. Days are those of the moment, local time.",
      "type": "object",
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Day"
          },
          "default": []
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/definitions/TimeOfDay"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/definitions/TimeOfDay"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Day": {
      "type": "string",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "TimeOfDay": {
      "description": "A time of day, \"HH:MM\", 00:00 to 23:59, local time.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "Alert": {
      "type": "object",
      "properties": {
        "entity": {
          "type": "string"
        },
        "state": {
          "description": "The state that raises the alert.",
          "type": "string",
          "default": "on"
        },
        "label": {
          "description": "Shown on the alert area: up to four characters large in its middle,\nup to eleven small along its top.",
          "type": "string"
        },
        "color": {
          "default": "#ff1e1e",
          "allOf": [
            {
              "$ref": "#/definitions/Colour"
            }
          ]
        },
        "pulse_seconds": {
          "description": "One pulse, in seconds.",
          "type": "number",
          "format": "float",
          "default": 1.5
        }
      },
      "additionalProperties": false,
      "required": [
        "entity",
        "label"
      ]
    },
    "Area": {
      "description": "A rectangle of the panel, in pixels.",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    }
  }
}
